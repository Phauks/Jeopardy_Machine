{
  "name": "@jeopardy/web",
  "version": "0.0.0",
  "private": true,
  "description": "SvelteKit app Worker: pages (editor, host console, board display, buzzer), REST API, and later D1/R2. Realtime WebSockets live in the sibling realtime Worker.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker",
    "test": "vitest run",
    "test:e2e": "pnpm run build && vitest run -c vitest.e2e.config.ts",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@jeopardy/engine": "workspace:*",
    "@jeopardy/protocol": "workspace:*",
    "three": "catalog:",
    "uqr": "catalog:"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/three": "catalog:",
    "playwright": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
