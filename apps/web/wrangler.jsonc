{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jeopardy-web",
  // The adapter emits the Worker entry + static assets here on `vite build`.
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-08-01",
  // nodejs_als: AsyncLocalStorage, required by SvelteKit's Cloudflare adapter runtime.
  "compatibility_flags": ["nodejs_als"],
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  // --- Bindings that arrive with later milestones, declared here so the shape is agreed ---
  // M3: reach the SAME GameRoomDO instances the realtime Worker owns, via cross-script
  // binding (script_name points at the sibling Worker) - used for room creation/game start.
  // Local dev status for this binding is tracked in docs/DEVELOPMENT.md.
  // "durable_objects": {
  //   "bindings": [
  //     { "name": "GAME_ROOM", "class_name": "GameRoomDO", "script_name": "jeopardy-realtime" }
  //   ]
  // },
  // Provisioned by owner via dashboard 2026-08-13. Server code starts using DB in M8/phase-2
  // (library stays IndexedDB-first until then) and MEDIA in M5 (Worker-proxied uploads with
  // limits from @jeopardy/protocol/limits) - bound now so deploys carry them from day one.
  // NOTE: confirm database_name matches the name chosen in the dashboard (id is authoritative).
  "d1_databases": [
    { "binding": "DB", "database_name": "jeopardy-machine", "database_id": "c12ef3a9-1c69-4f5d-8e87-e190123a74d6" },
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "jeopardy-machine-media" },
  ]
}
