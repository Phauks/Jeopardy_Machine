{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Name matches the Workers Builds project (owner created it as jeopardy-machine-web;
  // CI overrides mismatches and nags with a PR, so config follows the deployed reality).
  "name": "jeopardy-machine-web",
  // The adapter emits the Worker entry + static assets here on `vite build`.
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-08-01",
  // nodejs_als: AsyncLocalStorage, required by SvelteKit's Cloudflare adapter runtime.
  "compatibility_flags": ["nodejs_als"],
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  // M3 single-origin architecture (docs/decisions/2026-08-13-single-origin-binding.md):
  // this Worker reaches the SAME GameRoomDO instances the realtime Worker owns via this
  // cross-script binding - room creation (POST /api/rooms) and every player/display/host
  // WebSocket (/room/<CODE>/ws) ride it. Local dev: multi-config `wrangler dev` (both
  // configs in one process) - docs/DEVELOPMENT.md.
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoomDO",
        "script_name": "jeopardy-machine-realtime",
      },
    ],
  },
  // Provisioned by owner via dashboard 2026-08-13. DB's FIRST real use is the room registry
  // (docs/decisions/2026-08-14-room-visibility-and-lobby.md): the `rooms` table backing the
  // public lobby, created by migrations/0001_create_rooms.sql. The realtime Worker binds the
  // SAME database (apps/realtime/wrangler.jsonc) so the room DO can report its own
  // transitions - see that decision's registry-update addendum. The library keeps its
  // IndexedDB-first story until M8; MEDIA arrives in M5 (Worker-proxied uploads with limits
  // from @jeopardy/protocol/limits).
  // NOTE: confirm database_name matches the name chosen in the dashboard (id is authoritative).
  // Migrations are applied by hand from the runbook (docs/cloudflare-setup.md) - never by CI,
  // never by an agent session.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jeopardy-machine",
      "database_id": "c12ef3a9-1c69-4f5d-8e87-e190123a74d6",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "jeopardy-machine-media" }],
}
