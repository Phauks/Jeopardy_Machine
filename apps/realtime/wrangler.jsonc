{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jeopardy-machine-realtime",
  "main": "src/index.ts",
  // Bump deliberately, in its own commit, after reading the compat-date changelog.
  "compatibility_date": "2026-08-01",
  "observability": {
    // Workers Logs (persisted + queryable, includes DO logs). Free tier is generous; head
    // sampling can be added here if volume ever matters.
    "enabled": true,
  },
  // Readable stack traces in the dashboard; source maps are not served to clients.
  "upload_source_maps": true,
  "durable_objects": {
    "bindings": [
      // One DO instance per game room, addressed by idFromName(roomCode) - no lookup table.
      { "name": "GAME_ROOM", "class_name": "GameRoomDO" },
    ],
  },
  "migrations": [
    // SQLite-backed from birth: live game state (roster, scores, buzz log) must survive
    // hibernation/eviction, and SQLite classes are also what the free plan includes.
    { "tag": "v1", "new_sqlite_classes": ["GameRoomDO"] },
  ],
  // The SAME D1 database the web Worker binds (apps/web/wrangler.jsonc) - D1 bindings are
  // shareable, and this is how the room DO reports its own transitions (phase, roster count,
  // close/expiry) into the registry that backs the public lobby. Rationale, alternatives
  // considered, and the drift failure mode: docs/decisions/2026-08-14-room-visibility-and-
  // lobby.md, "Addendum: how registry updates reach D1".
  //
  // The MIGRATIONS live with the web Worker (apps/web/migrations) - one owner for the schema,
  // one apply command in the runbook. This Worker only ever writes rows.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jeopardy-machine",
      "database_id": "c12ef3a9-1c69-4f5d-8e87-e190123a74d6",
    },
  ],
}
