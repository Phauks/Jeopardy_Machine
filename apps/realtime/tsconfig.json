{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // worker-configuration.d.ts is generated by `wrangler types` (gitignored - regenerate,
    // never edit). It provides the workerd runtime globals and the Env interface.
    // The /types subpath contributes the cloudflare:test module declarations.
    "types": ["@cloudflare/vitest-pool-workers/types"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "worker-configuration.d.ts"]
}
