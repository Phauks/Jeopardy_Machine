{
  "name": "@jeopardy/realtime",
  "version": "0.0.0",
  "private": true,
  "description": "Realtime Worker: owns GameRoomDO (one Durable Object per game room). WebSocket-only surface; the SvelteKit app is a sibling Worker that reaches these DOs via a cross-script binding.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "types": "wrangler types",
    "check": "wrangler types && tsc --noEmit",
    "test": "wrangler types && vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@jeopardy/protocol": "workspace:*",
    "partyserver": "0.5.10"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
