{
  "name": "@jeopardy/protocol",
  "version": "0.0.0",
  "private": true,
  "description": "Shared wire/document contracts: versioned envelope, ext extension-bag convention, operational limits. The modularity keystone - client, SvelteKit server, and GameRoomDO all import identical types and validators.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./envelope": "./src/envelope/wire.ts",
    "./ext": "./src/ext.ts",
    "./limits": "./src/limits.ts",
    "./room/identity": "./src/room/identity.ts",
    "./room/roster": "./src/room/roster.ts",
    "./room/client-messages": "./src/room/client-messages.ts",
    "./room/server-messages": "./src/room/server-messages.ts",
    "./room/authority": "./src/room/authority.ts",
    "./room/buzz-fairness": "./src/room/buzz-fairness.ts",
    "./room/create": "./src/room/create.ts",
    "./room/visibility": "./src/room/visibility.ts",
    "./room/room-settings": "./src/room/room-settings.ts",
    "./room/live-rules": "./src/room/live-rules.ts",
    "./room/registry": "./src/room/registry.ts",
    "./room/diagnostics": "./src/room/diagnostics.ts",
    "./settings/player-mode": "./src/settings/groups/teams.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "generate:settings-docs": "node --experimental-strip-types scripts/generate-settings-docs.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
